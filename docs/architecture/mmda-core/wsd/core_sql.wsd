@startuml mmda-core-sql
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam shadowing false
set namespaceSeparator none
skinparam nodesep 12
skinparam ranksep 26
skinparam packageStyle rectangle
hide circle
hide empty members
title mmda-core-sql　类关系图（55 个类型 / 65,193 行）
legend right
  图中节点 34 / 55 个：按模块内被引用度排序取前 34
  实线空心箭头=extends；虚线空心箭头=implements
  <u>虚线开放箭头=类型引用</u>（数字=引用它的文件数，≥2 才画）
  真源：src/main/java 源码实测（import + 同包名引用 + extends/implements）
endlegend
package "sql" {
  class "SqlArg" as T5
  class "SqlCmd" as T6
  class "SqlConsts" as T26
  interface "SqlExecutable" as T10
  class "SqlJoin" as T27
  interface "SqlMetaContext" as T3
  class "SqlPatterns" as T28
  class "SqlQuery" as T9
  class "SqlQueryable" as T15
}
package "sql.antlr4" {
  interface "SqlParserListener" as T16
  class "SqlParserParser" as T17
  interface "SqlParserVisitor" as T18
  class "SqlQueryParser" as T19
  interface "SqlQueryParserListener" as T20
  interface "SqlQueryParserVisitor" as T21
}
package "sql.dialects" {
  abstract class "AnsiSqlDialect" as T4
  class "OracleDialect" as T12
  class "PostgreSqlDialect" as T22
  interface "SqlDialect" as T7
}
package "sql.expressions" {
  class "SqlArithmeticExp" as T13
  class "SqlCriteriaExp" as T0
  class "SqlExp" as T2
  interface "SqlExpVisitor" as T14
  enum "SqlOp" as T8
}
package "sql.schema" {
  class "Column" as T23
  interface "SchemaProvider" as T11
  class "Table" as T24
}
package "sql.types" {
  class "DbDataType" as T1
  class "DbDataTypeMap" as T25
  class "KingbaseDataTypes" as T29
  class "MySqlDataTypes" as T30
  class "OracleDataTypes" as T31
  class "PostgreSqlDataTypes" as T32
  class "SqlServerDataTypes" as T33
}
