  interface "EnumValue" as T0
  enum "ExtensionType" as T11
  enum "FetchMode" as T18
  enum "FieldAggregation" as T19
  enum "MetaRelationType" as T9
  enum "ModuleAuthScope" as T20
  enum "ModuleType" as T21
}
package "exceptions" {
  class "MetaEnumParseException" as T22
}
package "metadata" {
  interface "Authority" as T13
  class "MetaCol" as T6
  class "MetaConstraint" as T14
  interface "MetaContext" as T7
  abstract class "MetaEntity" as T1
  class "MetaEnum" as T15
  class "MetaObject" as T4
  class "MetaRelation" as T12
  class "MetaUiField" as T23
  class "Module" as T24
  class "ModuleAction" as T25
}
