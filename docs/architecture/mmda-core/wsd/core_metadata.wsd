@startuml mmda-core-metadata
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam shadowing false
set namespaceSeparator none
skinparam nodesep 12
skinparam ranksep 26
skinparam packageStyle rectangle
hide circle
hide empty members
title mmda-core-metadata　类关系图（105 个类型 / 11,581 行）
legend right
  图中节点 26 / 105 个：按模块内被引用度排序取前 26
  实线空心箭头=extends；虚线空心箭头=implements
  <u>虚线开放箭头=类型引用</u>（数字=引用它的文件数，≥2 才画）
  真源：src/main/java 源码实测（import + 同包名引用 + extends/implements）
endlegend
package "data.conversion" {
  interface "BiConverter" as T5
  abstract class "DataTypeHandler" as T10
}
