@startuml mmda-core-messaging
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam shadowing false
set namespaceSeparator none
skinparam nodesep 12
skinparam ranksep 26
skinparam packageStyle rectangle
hide circle
hide empty members
title mmda-core-messaging　类关系图（36 个类型 / 2,160 行）
legend right
  图中节点 31 / 36 个：按模块内被引用度排序取前 34
  实线空心箭头=extends；虚线空心箭头=implements
  <u>虚线开放箭头=类型引用</u>（数字=引用它的文件数，≥2 才画）
  真源：src/main/java 源码实测（import + 同包名引用 + extends/implements）
endlegend
package "messaging" {
  interface "Message" as T1
  interface "Sender" as T0
}
package "messaging.config" {
  class "Config" as T13
  class "MessagingConfiguration" as T2
}
package "messaging.ding" {
  class "DingMessage" as T7
  abstract class "DingSender" as T4
}
package "messaging.ding.impl" {
  class "GroupDingSender" as T14
  class "RobotDingSender" as T15
}
package "messaging.email" {
  class "EmailMessage" as T25
}
package "messaging.phoneCall" {
  class "PhoneCallMessage" as T9
  abstract class "PhoneCallSender" as T5
}
package "messaging.phoneCall.impl" {
  class "AliYunPhoneCallSender" as T16
  class "HuaWeiPhoneCallSender" as T17
}
package "messaging.push" {
  class "PushMessage" as T26
  class "PushRequest" as T27
  class "PushResponse" as T28
}
package "messaging.sms" {
  class "SmsMessage" as T11
  abstract class "SmsSender" as T8
}
package "messaging.sms.impl" {
  class "AliyunSmsSender" as T18
}
package "messaging.tokens" {
  class "MessageToken" as T19
  interface "MessageTokenStore" as T12
}
package "messaging.wechat" {
  class "AccessToken" as T29
  class "QrCode" as T30
  class "Scene" as T20
  class "SceneStr" as T21
  class "TemplateMessage" as T22
  class "WeChatMessage" as T6
  abstract class "WeChatSender" as T3
}
package "messaging.wechat.impl" {
  class "WeChatOfficialAccountSender" as T23
  class "WeChatPointToPointSender" as T24
  class "WeChatServiceAccountSender" as T10
}
